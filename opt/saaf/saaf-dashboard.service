[Unit]
Description=SAAF Pro Dashboard
After=network.target

[Service]
Type=simple
User=admin_ubuntu
WorkingDirectory=/home/admin_ubuntu/Desktop/proyecto_saaf/opt/saaf
ExecStart=/home/admin_ubuntu/Desktop/proyecto_saaf/opt/saaf/saaf-dashboard-start.sh
Restart=on-failure
RestartSec=10
EnvironmentFile=/home/admin_ubuntu/Desktop/proyecto_saaf/opt/saaf/config/saaf.env

[Install]
WantedBy=multi-user.target