[Unit]
Description=SAAF Pro Scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin_ubuntu
WorkingDirectory=/home/admin_ubuntu/Desktop/proyecto_saaf/opt/saaf
EnvironmentFile=/home/admin_ubuntu/Desktop/proyecto_saaf/opt/saaf/config/saaf.env
ExecStart=/home/admin_ubuntu/Desktop/proyecto_saaf/opt/saaf/saaf_start.sh
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
